{
  "name": "checklist-director-nq",
  "version": "1.0.1",
  "description": "Director's Branch Visit Checklist & Inspection System for NurulQuran Pakistan",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute director_checklist_db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute director_checklist_db --remote --file=./schema.sql"
  },
  "keywords": [
    "nurulquran",
    "director-checklist",
    "cloudflare-workers",
    "cloudflare-d1"
  ],
  "author": "NurulQuran Pakistan",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
