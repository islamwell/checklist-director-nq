{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checklist-director-nq",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "director_checklist_db",
      "database_id": "director_checklist_db"
    }
  ]
}
